# Normalize line endings in the repository while keeping Windows checkouts native.
# Without this, every file shows as modified on Windows after a checkout.
* text=auto eol=lf

*.ts text
*.tsx text
*.mts text
*.mjs text
*.json text
*.js text
*.css text
*.md text
*.html text
*.txt text
*.svg text

# Shell scripts must keep LF in the repository. A CRLF shebang makes the
# kernel refuse the interpreter and `bash deploy-vps.sh` has to be used
# instead of ./deploy-vps.sh.
*.sh text eol=lf

# Binary assets must never be touched.
*.ttf binary
*.woff binary
*.woff2 binary
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.zip binary
*.docx binary
*.xlsx binary
